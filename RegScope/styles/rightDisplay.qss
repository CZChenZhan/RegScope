QFrame#rightDisplay {
    background-color: #1e1f22;
    border: 1px solid #31343b;
    border-radius: 8px;
    color: #cfd6e4;
}

QFrame#rightDisplayHeader {
    background-color: #25262b;
    border: none;
    border-bottom: 1px solid #31343b;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QLabel#rightDisplayTitle {
    color: #f0f3f8;
    font-family: "Segoe UI", "Microsoft YaHei UI";
    font-size: 11pt;
    font-weight: 600;
}

QLabel#rightDisplayMeta {
    color: #8f9aae;
    font-family: "Segoe UI", "Microsoft YaHei UI";
    font-size: 9pt;
}
